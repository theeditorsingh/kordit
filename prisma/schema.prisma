generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String    @id @default(cuid())
  name           String?
  username       String?   @unique
  password       String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  workspaceRole  String    @default("Member") // Owner, Admin, Member, Guest
  // Bumped on password change; JWTs carrying an older value are rejected
  sessionVersion Int       @default(0)
  accounts       Account[]
  sessions       Session[]

  // Kordit Relations
  ownedBoards            Board[]                 @relation("BoardOwner")
  memberships            Member[]
  activities             Activity[]
  comments               Comment[]
  auditLogs              AuditLog[]
  notifications          Notification[]          @relation("NotificationRecipient")
  notificationActions    Notification[]          @relation("NotificationActor")
  notificationPreference NotificationPreference?
  uiPreference           UiPreference?
  ownedWorkspaces        Workspace[]             @relation("WorkspaceOwner")
  workspaceMemberships   WorkspaceMember[]
  workspaceInvitesSent   WorkspaceInvite[]       @relation("WorkspaceInviteSender")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Kordit Models

model Board {
  id             String   @id @default(cuid())
  title          String
  slug           String
  color          String   @default("#0052CC")
  visibility     String   @default("Workspace") // Private, Workspace, Public
  background     String   @default("") // URL or gradient CSS
  backgroundType String   @default("color") // color, gradient, image
  labelColors    Json     @default("[]") // Custom label colours saved for reuse (hex strings)
  isArchived     Boolean  @default(false)
  isFavorite     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerId String
  owner   User   @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  columns       Column[]
  cards         Card[]
  members       Member[]
  activities    Activity[]
  automations   Automation[]
  boardLabels   BoardLabel[]
  notifications Notification[]

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([ownerId, slug])
  @@index([workspaceId])
}

model Column {
  id        String   @id @default(cuid())
  title     String
  color     String   @default("#0052CC")
  icon      String   @default("")
  order     Int      @default(0)
  wipLimit  Int      @default(0) // 0 = no limit
  settings  Json     @default("{}") // sortBy, defaultPriority, defaultLabel, autoComplete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards Card[]

  @@index([boardId, order])
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  priority    String    @default("none") // none, urgent, high, medium, low
  dueDate     DateTime?
  reminderAt  DateTime? // When to fire the reminder notification
  completedAt DateTime? // Set when the card is ticked off; it then sits in its column's Completed section
  order       Int       @default(0)
  coverImage  String    @default("") // URL of cover image
  coverColor  String    @default("") // Solid color cover
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  // JSON fields
  labels      Json @default("[]")
  checklist   Json @default("[]")
  assigneeIds Json @default("[]")

  comments      Comment[]
  activities    Activity[]
  notifications Notification[]

  @@index([boardId])
  @@index([columnId, order])
}

model Member {
  id         String   @id @default(cuid())
  role       String   @default("Member") // Admin, Member, Guest
  isFavorite Boolean  @default(false) // This member starred the board (per user)
  createdAt  DateTime @default(now())

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

// Activity Feed
model Activity {
  id        String   @id @default(cuid())
  action    String // card_created, card_moved, card_updated, card_deleted, member_added, column_created, etc.
  details   Json     @default("{}") // { cardTitle, fromColumn, toColumn, fieldChanged, ... }
  createdAt DateTime @default(now())

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cardId String?
  card   Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt])
}

// Card Comments
model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

// Audit Log
model AuditLog {
  id        String   @id @default(cuid())
  action    String // invite_member, change_role, delete_board, delete_card, bulk_delete, etc.
  target    String // "board:<id>", "card:<id>", "user:<id>"
  details   Json     @default("{}")
  ipAddress String?
  createdAt DateTime @default(now())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
}

// Board-Level Label Library
model BoardLabel {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#0052CC")
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([boardId, name])
  @@index([boardId])
}

// Automations
model Automation {
  id           String   @id @default(cuid())
  name         String
  isActive     Boolean  @default(true)
  trigger      String // card_moved_to, due_date_passed, checklist_completed, card_created
  condition    Json     @default("{}") // { columnId, priority, ... }
  action       String // move_card, set_priority, complete_checklist, set_due_date
  actionConfig Json     @default("{}") // { targetColumnId, priority, ... }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, trigger])
}

// Persisted collaboration inbox
model Notification {
  id        String   @id @default(cuid())
  type      String // assignment, comment, mention, invitation
  message   String
  isRead    Boolean  @default(false)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  boardId String?
  board   Board?  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cardId String?
  card   Card?   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([boardId])
  @@index([cardId])
}

model NotificationPreference {
  userId      String   @id
  assignments Boolean  @default(true)
  comments    Boolean  @default(true)
  mentions    Boolean  @default(true)
  invitations Boolean  @default(true)
  dueSoon     Boolean  @default(true)
  browser     Boolean  @default(true)
  email       Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// User-scoped visual preferences that follow the account across devices.
model UiPreference {
  userId     String   @id
  theme      String   @default("light")
  appearance String   @default("kordit")
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Workspace-level team directory. Boards remain independently permissioned;
// workspace membership is the source for centralized team administration.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members WorkspaceMember[]
  invites WorkspaceInvite[]
  boards  Board[]

  @@index([ownerId])
}

model WorkspaceMember {
  id        String   @id @default(cuid())
  role      String   @default("Member") // Owner, Admin, Member
  createdAt DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id         String    @id @default(cuid())
  email      String
  role       String    @default("Member")
  status     String    @default("Pending") // Pending, Accepted, Revoked
  token      String    @unique @default(cuid())
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("WorkspaceInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([email, status])
}

// Fixed-window counters for rate limiting (login, magic links, AI, invites)
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}
